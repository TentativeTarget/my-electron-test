# macOS
.DS_Store

# Dependencies
node_modules/
__pycache__/
*.pyc

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Environment files
.env
.env.*
!.env.example

# ─── 後端執行時產生的使用者資料：一律不提交 ───
# 帳號、密碼雜湊與好友關係
/users.json
# 筆記內文與讀寫權限
/notes.json
# 頭像與筆記圖片（後端上傳目錄）
/data/
# 舊版上傳目錄，已搬到 data/（保留規則避免舊版再度寫入）
/frontend/assets/
# 啟動器的 PID 檔（launcher.js 會在專案根目錄產生）
/.collabnote-pids.json
# 原子寫入中斷時可能留在根目錄的暫存檔，內容等同 notes.json / users.json
/tmp*

# 打包輸出
/dist/

# ─── 本機趣味工具：完整功能測試監控器（單檔案、不提交）───
/monitor-tests.py
